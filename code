% parameters
mp=0.285; mw=0.025;
Jp=0.001; Jw=0.0013;
rw=0.022; l=0.1;
c=0.0001;
kt=0.3; kb=0.5; R=5;
g=9.81;
a = Jw/rw^2;
b = (kt*kb)/(R*rw^2);
d = (kt*kb)/(R*rw);

% steady state space for the minseg model
M = [mp+mw+a mp*l;
mp*l Jp+mp*l^2];

C = [(c/rw^2)+b -(c/rw)-d;
-(c/rw)-d c+(kb*kt)/R];

K = [0 0;
0 -mp*g*l];

F = [kt/(R*rw);
-kt/R];

Part 1.2
% State-space matrices
A = [zeros(2) eye(2);
-M\K -M\C]

B = [zeros(2,1);
M\F]

% Eigenvalues check
eig(A)

Part 1.3
% Initial Matrix System (Angle = pi/60)
q0 = [0; pi/60; 0; 0];
C1 = eye(4);
D1 = zeros(4,1);

% State-space system
sys = ss(A, B, C1, D1);

% Simulations
[t, y ] = deal([], []);
[t1, y1] = deal([], []);
[y, t ] = initial(sys, q0, 10);
[y1, t1] = initial(sys, q0, 0.1);

% Plot (10 s)
figure
plot(t, y)
title('Open Loop Response (10 s)')
xlabel('Time (s)')
ylabel('Results')
legend('x (m)','\theta (rad)','x dot (m/s)','\theta dot (rad/s)')
grid on

% Plot (0.1 s)
figure
plot(t1, y1)
title('Open Loop Response (0.1 s)')
xlabel('Time (s)')
ylabel('Results')
legend('x (m)','\theta (rad)','x dot (m/s)','\theta dot (rad/s)')
grid on


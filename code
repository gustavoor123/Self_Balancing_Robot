load_system(model)
saveas(get_param(model,'Handle'),'model_output.png')
figure
imshow('model_output.png')

% For 10 degrees
% Pole placement
P = -8.7 * ones(1,4);
K = acker(A, B, P);
Acl = A - B*K;

% Closed-loop system
Bcl = zeros(size(B));
Ccl = eye(size(A));
Dcl = D1;
sys = ss(Acl, Bcl, Ccl, Dcl);

% Initial condition
q0 = [0; 10*pi/180; 0; 0];
[y, t, q] = initial(sys, q0);

% Eigenvalues
disp("Open Loop Eigenvalues: " + eig(A))
disp("Ackerman Eigenvalues: " + eig(Acl))

% State response
figure
plot(t, q)
title('Closed Loop System (10 Degrees)')
xlabel('Time (s)')
ylabel('Results')
legend('x (m)', '\theta (rad)', 'x dot (m/s)', '\theta dot (rad/s)')
grid on

% Control input
u = -K * q';
figure
plot(t, u)
title('Closed Loop: Control Input Voltage')
xlabel('Time (s)')
ylabel('Voltage')
grid on
disp("Max Voltage: " + max(abs(u)))

